# Aliyun SLS credentials. Use a RAM user with least-privilege read access.
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret
# Optional. Set this only when using temporary STS credentials.
ALIBABA_CLOUD_SECURITY_TOKEN=your_security_token

# SLS endpoint for the Project region, for example:
# cn-hangzhou.log.aliyuncs.com
# cn-hangzhou-intranet.log.aliyuncs.com
ALIYUN_SLS_ENDPOINT=your-region.log.aliyuncs.com

# Defaults extracted from the console URL you shared.
ALIYUN_SLS_PROJECT=k8s-log-cc338bd1e67fa4d8e9be4ad1e9435670a
ALIYUN_SLS_LOGSTORE=dsers-app
